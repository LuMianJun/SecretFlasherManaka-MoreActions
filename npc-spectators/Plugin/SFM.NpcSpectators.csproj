<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SFM.NpcSpectators</AssemblyName>
  </PropertyGroup>
  <Import Project="../../shared/PluginReferences.props" />
  <ItemGroup>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Preserve the existing Harmony patch declaration order when adding files. -->
  <ItemGroup>
    <Compile Include="Integration/ActionEventBridge.cs" />
    <Compile Include="Integration/CrowdApi.cs" />
    <Compile Include="Gathering/CrowdDriver.cs" />
    <Compile Include="Native/Spectator.cs" />
    <Compile Include="Native/CrowdNativePatches.cs" />
    <Compile Include="Gathering/CrowdPolicy.cs" />
    <Compile Include="Gathering/CrowdVisibility.cs" />
    <Compile Include="Integration/MmdBridge.cs" />
    <Compile Include="Plugin.cs" />
    <Compile Include="../../shared/ModOptions.cs" Link="ModOptions.cs" />
  </ItemGroup>
</Project>
